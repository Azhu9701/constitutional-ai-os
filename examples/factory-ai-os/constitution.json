{
  "spec_version": "0.1",
  "constitution_id": "example:factory-ai-os",
  "name": "Factory AI OS",
  "version": "0.1.0",
  "description": "Example constitution for agents and robots operating in a physical production environment.",
  "scope": {
    "subjects": [
      "agent:*",
      "robot:*",
      "role:operator",
      "role:safety-officer"
    ],
    "environments": [
      "factory"
    ]
  },
  "principles": [
    {
      "id": "p1",
      "title": "Independent physical safety",
      "statement": "Constitutional permission never bypasses independent machine safety controls.",
      "class": "enforceable",
      "priority": 100
    },
    {
      "id": "p2",
      "title": "Traceable actuation",
      "statement": "Consequential physical actions produce an attributable decision and action receipt.",
      "class": "auditable",
      "priority": 90
    }
  ],
  "authorities": [
    {
      "id": "operations",
      "holder": "role:operator",
      "type": "role",
      "powers": [
        "schedule",
        "operate",
        "pause"
      ],
      "delegable": true,
      "revocable_by": [
        "role:safety-officer"
      ]
    },
    {
      "id": "safety",
      "holder": "role:safety-officer",
      "type": "role",
      "powers": [
        "shutdown",
        "deny-motion",
        "revoke-physical-capabilities"
      ],
      "delegable": false,
      "revocable_by": []
    }
  ],
  "ownership": [
    {
      "resource_class": "robot:*",
      "relationship": "owner",
      "holder": "organization:factory",
      "conditions": []
    },
    {
      "resource_class": "safety-telemetry",
      "relationship": "custodian",
      "holder": "organization:factory",
      "conditions": [
        "retention-policy-applies"
      ]
    }
  ],
  "rights": [
    {
      "id": "r1",
      "subject": "robot:*",
      "action": "motion.execute",
      "resource": "zone:human-occupied",
      "effect": "deny",
      "authority": "safety",
      "class": "enforceable",
      "conditions": [
        "human-present"
      ],
      "justification": "Physical safety boundary.",
      "appeal_to": null,
      "priority": 1000
    },
    {
      "id": "r2",
      "subject": "agent:*",
      "action": "robot.command",
      "resource": "robot:*",
      "effect": "require",
      "authority": "operations",
      "class": "enforceable",
      "requirements": [
        "valid-delegation",
        "fresh-safety-state",
        "action-receipt"
      ],
      "appeal_to": "role:operator",
      "priority": 500
    }
  ],
  "amendment": {
    "proposers": [
      "role:operator",
      "role:safety-officer"
    ],
    "approvers": [
      "organization:factory"
    ],
    "threshold": {
      "type": "count",
      "value": 1
    },
    "notice_period": "P1D",
    "audit_required": true,
    "emergency_amendment": {
      "allowed": true,
      "authority": "role:safety-officer",
      "expires_after": "PT8H",
      "post_review_required": true
    }
  },
  "enforcement": {
    "missing_policy": "deny",
    "conflict": "most-restrictive",
    "engine_failure": "safe-mode",
    "decision_types": [
      "ALLOW",
      "DENY",
      "REQUIRE",
      "ESCALATE"
    ]
  },
  "provenance": {
    "issuer": "example:constitutional-ai-os",
    "created_at": "2026-10-01T00:00:00Z",
    "effective_at": null,
    "supersedes": null,
    "signature": null
  }
}