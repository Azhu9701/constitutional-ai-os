{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:caios:schema:resource-policy:v0.1",
  "title": "Constitutional AI OS Resource Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "version",
    "rules"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect",
          "subjects",
          "actions",
          "resources",
          "authority",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "ALLOW",
              "DENY",
              "REQUIRE",
              "ESCALATE"
            ]
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authority": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    }
  }
}